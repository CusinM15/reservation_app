# ── Produkcijska konfiguracija (PostgreSQL) ──────────────────────────
# Vse spremenljivke, ki jih aplikacija bere. Na k8s prihajajo iz
# ConfigMap (sola-config) in Secret (sola-secrets).
# Vse vrednosti tukaj so PRIMERI — na produkcijskih strežnikih so
# prave vrednosti v k8s, ne v .env datoteki.

# ── App ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8002
BASE_URL=https://ostc-app.org

# ── Podatkovna baza (OBVEZEN — PostgreSQL, brez SQLite) ─────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Kapaciteta tablic ───────────────────────────────────────────────
TABLICE_MAX=28

# ── Urnik (JSON, indeks ure -> opis) ────────────────────────────────
SCHEDULE={"0":"7.00 - 7.45","1":"7.50 - 8.35","2":"8.40 - 9.25","3":"9.30 - 10.15","4":"10.25 - 11.10","5":"11.15 - 12.00","6":"12.05 - 12.50","7":"12.55 - 13.40"}

# ── Razredi in prostori (vejica-ločeno) ─────────────────────────────
RAZREDI=1.a,1.b,1.c,1.č,2.a,2.b,2.c,2.č,3.a,3.b,3.c,3.č,4.a,4.b,4.c,4.č,5.a,5.b,5.c,5.č,6.a,6.b,6.c,6.č,7.a,7.b,7.c,8.a,8.b,8.c,8.č,8.1,8.2,8.3,8.4,8.5,9.a,9.b,9.c,9.1,9.2,9.3,9.4,9.5
PROSTORI=tablice,racunalnica,ladja,gospodinjska-ucilnica

# ── Timeout neaktivnosti (minute) ───────────────────────────────────
INACTIVITY_TIMEOUT_MINUTES=30
INACTIVITY_TIMEOUT_ADMIN_MINUTES=20

# ── Ponastavitev gesla (minute veljavnosti) ─────────────────────────
RESET_TOKEN_EXPIRATION_MINUTES=120

# ── Email (Arnes SMTP) ──────────────────────────────────────────────
MAIL_SERVER=mail.arnes.si
MAIL_PORT=587
MAIL_FROM=os-toneta.cufarja-jesenice@guest.arnes.si
MAIL_USERNAME=user@guest.arnes.si
MAIL_PASSWORD=change-me
BACKUP_EMAIL=admin@ostc.si
STANJE_MAIL=admin@ostc.si
ADMIN_EMAIL=admin@ostc.si

# ── Audit log token (dostop do /history?token=...) ──────────────────
# Ustvari npr. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_TOKEN=change-me
