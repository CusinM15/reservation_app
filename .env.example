# ═══════════════════════════════════════════════════════════════════
# .env.example — PRODUKCIJSKA šablona (k3s: k3s-1 + k3s-2)
#
# Ta datoteka vsebuje SAMO tisto, kar rabi produkcija.
# SQLite NI podprt — produkcija uporablja izključno PostgreSQL!
#
# V k8s se te vrednosti nastavijo preko:
#   - ConfigMap: k8s/app/base/sola-configmap.yaml
#   - Secret:    k8s/secrets/README.md (kubectl create secret ...)
#
# Za LOKALNI razvoj uporabi ločeno datoteko (npr. .env.local) —
# ta šablona je izključno za produkcijo.
# ═══════════════════════════════════════════════════════════════════

# ── Strežnik ────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8002
# Javni naslov aplikacije (uporablja se za povezave v emailih)
BASE_URL=https://ostc-app.org

# ── Podatkovna baza (OBVEZNO PostgreSQL) ────────────────────────────
# DATABASE_URL je obvezen — brez njega se app ne zažene.
# V k8s: postgresql://sola:PASSWORD@sola-db-rw.sola:5432/sola
DATABASE_URL=postgresql://sola:PASSWORD@sola-db-rw.sola:5432/sola

# ── Email (SMTP preko Arnesa) ───────────────────────────────────────
MAIL_FROM=sola@ostc-app.org
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_SERVER=mail.arnes.si
MAIL_PORT=587
# Kam leti dnevno poročilo o zdravju sistema
BACKUP_EMAIL=CHANGE_ME@ostc.si
# Namensko poročanje o stanju sistema (dnevni report)
STANJE_MAIL=CHANGE_ME@ostc.si

# ── Aplikacija ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@ostc.si
TABLICE_MAX=28
# Čas veljavnosti povezave za ponastavitev gesla (minute)
RESET_TOKEN_EXPIRATION_MINUTES=30

# Urnik (JSON: številka ure -> začetek-konec)
SCHEDULE={"0":"07:30-08:15","1":"08:20-09:05","2":"09:15-10:00","3":"10:20-11:05","4":"11:10-11:55","5":"12:00-12:45","6":"12:50-13:35","7":"14:00-14:45"}

# Razredi (vejica-ločeno)
RAZREDI=IP/NIP/ID,1.a,1.b,1.c,1.č,2.a,2.b,2.c,2.č,3.a,3.b,3.c,3.č,4.a,4.b,4.c,4.č,5.a,5.b,5.c,5.č,6.a,6.b,6.c,6.č,7.a,7.b,7.c,8.a,8.b,8.c,8.č,8.1,8.2,8.3,8.4,8.5,8.6,9.a,9.b,9.c,9.1,9.2,9.3,9.4,9.5

# Prostori za rezervacijo
PROSTORI=tablice,racunalnica,ladja,gospodinjska-ucilnica

# ── Varnost ─────────────────────────────────────────────────────────
# Token za dostop do /history?token=... (če nisi prijavljen)
# Ustvari: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_TOKEN=CHANGE_ME

# ── Opcijsko (privzete vrednosti so OK) ─────────────────────────────
# INACTIVITY_TIMEOUT_MINUTES=30        # samodejna odjava učiteljev
# INACTIVITY_TIMEOUT_ADMIN_MINUTES=20  # samodejna odjava admin/vodstvo
