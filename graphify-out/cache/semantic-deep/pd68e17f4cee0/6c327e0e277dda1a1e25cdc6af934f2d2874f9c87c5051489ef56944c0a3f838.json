{"nodes": [{"id": "documentation_en_k3s_setup", "label": "K3s Setup Guide", "file_type": "document", "source_file": "documentation/en/k3s-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Matej \u010cu\u0161in", "contributor": null, "rationale": null}, {"id": "concept_metallb", "label": "MetalLB LoadBalancer (Layer2)", "file_type": "concept", "source_file": "documentation/en/k3s-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "k3s built-in servicelb and traefik are disabled so two load balancers don't fight; MetalLB Layer2 lets the LB IP float to the surviving node, making failover automatic."}, {"id": "concept_k3s", "label": "k3s Kubernetes Cluster", "file_type": "concept", "source_file": "documentation/en/k3s-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both nodes run as control-plane because with only 2 nodes a dedicated master is wasted hardware; k3s (not full Kubernetes) is used because it is designed for small/edge systems like school laptops."}, {"id": "concept_longhorn", "label": "Longhorn distributed storage", "file_type": "concept", "source_file": "documentation/en/k3s-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replica count fixed at 2 because there are exactly 2 nodes \u2014 a third copy is physically impossible; each node needs a dedicated non-system disk so it can run independently."}, {"id": "concept_etcd", "label": "etcd (embedded cluster state)", "file_type": "concept", "source_file": "documentation/en/k3s-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 2-node etcd quorum is technically risky for writes but accepted for this school use-case; k3s tolerates one node down for reads, which is sufficient here."}], "edges": [{"source": "documentation_en_k3s_setup", "target": "documentation_diagrams_k3s_setup_arhitektura_png", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/k3s-setup.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_k3s_setup", "target": "repo_k8s", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/k3s-setup.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_k3s_setup", "target": "concept_k3s", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/k3s-setup.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_k3s_setup", "target": "concept_etcd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/k3s-setup.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_k3s_setup", "target": "concept_metallb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/k3s-setup.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_k3s_setup", "target": "concept_longhorn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/k3s-setup.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_k3s_setup", "target": "concept_cnpg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/k3s-setup.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_k3s_setup", "target": "concept_postgresql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/k3s-setup.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_k3s_setup", "target": "co