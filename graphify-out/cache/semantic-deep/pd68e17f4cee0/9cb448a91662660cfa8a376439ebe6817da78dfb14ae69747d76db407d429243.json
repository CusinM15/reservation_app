{"nodes": [{"id": "documentation_ha_page", "label": "HA architecture documentation", "file_type": "document", "source_file": "documentation/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Matej \u010cu\u0161in", "contributor": null, "rationale": null}, {"id": "concept_cnpg", "label": "CloudNativePG (CNPG)", "file_type": "concept", "source_file": "documentation/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CNPG operator acts as a watchman for the database: automatic failover with failoverDelay=30s, enablePDB=true and podAntiAffinity \u2014 no custom failover scripts."}, {"id": "concept_metallb", "label": "MetalLB", "file_type": "concept", "source_file": "documentation/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MetalLB (Layer2) advertises the fixed LoadBalancer IP; if a node dies the IP migrates automatically to the other node, so users never notice."}, {"id": "concept_longhorn", "label": "Longhorn (distributed storage)", "file_type": "concept", "source_file": "documentation/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distributed block storage \u2014 data is replicated to both nodes so one node can die without data loss (RPO max a few seconds of async replication)."}, {"id": "concept_etcd", "label": "etcd (embedded k3s state)", "file_type": "concept", "source_file": "documentation/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "k3s uses embedded etcd for cluster state; with 2 nodes, writes need confirmation from both \u2014 technically risky but acceptable for this use case (no SLA)."}, {"id": "concept_sola_db_rw", "label": "sola-db-rw (database service)", "file_type": "concept", "source_file": "documentation/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The rw service always points to the current primary and the app uses it exclusively via DATABASE_URL, so the app never needs to know which node is primary."}, {"id": "concept_hpa", "label": "HorizontalPodAutoscaler", "file_type": "concept", "source_file": "documentation/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Autoscaling based on CPU (60%) and memory (70%): 2 replicas at rest, 3\u20134 during high load (start of school year)."}], "edges": [{"source": "concept_solski_app", "target": "concept_k3s", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "documentation/HA.md", "source_location": null, "weight": 1.0}, {"source": "concept_solski_app", "target": "concept_sola_db_rw", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "documentation/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_ha_page", "target": "concept_k3s", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_ha_page", "target": "concept_cnpg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_ha_page", "target": "concept_metallb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_ha_page", "target": "concept_longhorn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/HA.md", "source_location": null, "weight": 1.0}, {"source":