# ─────────────────────────────────────────────────────────────────────────
# deploy/oracle/.env.example — kopiraj v .env in izpolni
#   cp .env.example .env && nano .env
# ─────────────────────────────────────────────────────────────────────────
# Domena in javni naslov (Cloudflare DNS → IP VM)
BASE_HOST=app.tvoja-domena.si
BASE_URL=https://app.tvoja-domena.si

# Skrivnosti — zamenjaj z dolgimi naključnimi nizi:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=zamenjaj-me
POSTGRES_PASSWORD=zamenjaj-me

# Privzeta (prva) šola in glavni admin
SCHOOL_NAME=Demo šola
DEFAULT_SCHOOL_SLUG=demo
MAIN_ADMIN_USERNAME=mainadmin
MAIN_ADMIN_PASSWORD=zamenjaj-me-z-mocnim-geslom
MAIN_ADMIN_EMAIL=

# Pošta (obvestila, obnovitev gesla, varnostne kopije)
MAIL_SERVER=mail.arnes.si
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=app@tvoja-domena.si
ADMIN_EMAIL=app@tvoja-domena.si
BACKUP_EMAIL=app@tvoja-domena.si

# Število delavcev uvicorna. Na majhnem VM (E2.1.Micro, 1 GB) = 1.
# Na ARM A1 (12 GB) ali večjem stroju lahko dvigneš na 2–4.
WEB_WORKERS=1
