{"nodes": [{"id": "documentation_en_ha", "label": "HA Architecture Documentation", "file_type": "document", "source_file": "documentation/en/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Matej \u010cu\u0161in", "contributor": null, "rationale": "Explains why each HA choice exists (one replica per node, CNPG failover, etcd quorum caveats) rather than just what to run, so a future admin can reason about node failures instead of memorizing commands."}, {"id": "concept_sola_db", "label": "sola-db (CNPG PostgreSQL cluster)", "file_type": "concept", "source_file": "documentation/en/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streaming replication mirrors every write to the replica; an RPO of a few seconds is accepted. WAL and data use separate PVCs because their I/O profiles differ."}, {"id": "concept_sola_db_1", "label": "sola-db-1 (PRIMARY)", "file_type": "concept", "source_file": "documentation/en/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_sola_db_2", "label": "sola-db-2 (REPLICA)", "file_type": "concept", "source_file": "documentation/en/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asynchronously mirrors the primary; after failover it becomes the new primary and accepts writes \u2014 no manual intervention needed."}, {"id": "concept_sola_db_rw", "label": "sola-db-rw service (write+read, points to primary)", "file_type": "concept", "source_file": "documentation/en/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app only ever uses sola-db-rw via DATABASE_URL so it never needs to know which node is currently primary."}, {"id": "concept_cnpg", "label": "CloudNativePG (CNPG) operator", "file_type": "concept", "source_file": "documentation/en/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No custom failover scripts \u2014 the operator handles promotion; failoverDelay=30s prevents false failovers during brief outages, accepting ~1-2 min downtime which is fine for a school."}, {"id": "concept_hpa", "label": "HorizontalPodAutoscaler (sola-app-hpa)", "file_type": "concept", "source_file": "documentation/en/HA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One replica per node is the HA minimum; HPA scales 2\u21924 replicas on CPU 60%/MEM 70% to cover start-of-school-year demand without over-provisioning."}], "edges": [{"source": "documentation_en_ha", "target": "documentation_diagrams_ha_network_png", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_ha", "target": "concept_sola_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_ha", "target": "concept_cloudflare", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_ha", "target": "concept_metallb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_ha", "target": "concept_sola_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "documentation/en/HA.md", "source_location": null, "weight": 1.0}, {"source": "documentation_en_ha", "target": "concept_cnpg", "relation": "re