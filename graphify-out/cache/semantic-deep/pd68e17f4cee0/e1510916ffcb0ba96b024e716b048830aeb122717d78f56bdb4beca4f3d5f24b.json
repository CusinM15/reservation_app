{"nodes": [{"id": "documentation_admin_devops_navodila_page", "label": "Admin & DevOps instructions", "file_type": "document", "source_file": "documentation/admin-devops-navodila.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Matej \u010cu\u0161in", "contributor": null, "rationale": null}, {"id": "concept_k3s", "label": "k3s (Kubernetes)", "file_type": "concept", "source_file": "documentation/admin-devops-navodila.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_db_backup", "label": "Daily database backup (cron)", "file_type": "concept", "source_file": "documentation/admin-devops-navodila.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_dump emailed every night at 04:00, when nobody uses the app, so the backup is consistent \u2014 worst case loses one day of data."}, {"id": "concept_daily_report", "label": "Daily cluster status report (cron)", "file_type": "concept", "source_file": "documentation/admin-devops-navodila.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If one node dies the app keeps working but nobody notices \u2014 the daily report flags the degraded node before the second one fails too."}, {"id": "concept_ubuntu_server", "label": "Ubuntu Server 24.04 LTS", "file_type": "concept", "source_file": "documentation/admin-devops-navodila.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ubuntu Server chosen over Desktop: fewer packages mean more RAM for the app and a smaller attack surface for attackers."}, {"id": "concept_hermes_agent", "label": "Hermes Agent (AI CLI)", "file_type": "concept", "source_file": "documentation/admin-devops-navodila.md", "source_location": null, "source_url": null, "captured_at": nul